{
  "name": "ledok",
  "productName": "LeDoK",
  "version": "1.1.3",
  "description": "LeDoK – Lernentwicklungsdokumentation Grundschule (Desktop-App, offline)",
  "author": "Dominik Kraus",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.js",
  "scripts": {
    "start": "node scripts/version-sync.js && electron .",
    "pruefen": "node scripts/pruefen.js",
    "test": "node scripts/pruefen.js && playwright test",
    "release": "node scripts/release.js",
    "dist:win": "node scripts/version-sync.js && electron-builder --win --publish never",
    "dist:mac": "node scripts/version-sync.js && electron-builder --mac --publish never",
    "dist:linux": "node scripts/version-sync.js && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.deep-moments.ledok",
    "productName": "LeDoK",
    "copyright": "© 2026 Dominik Kraus",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "app/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "LeDoK-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "de_DE"
      ],
      "language": "1031",
      "shortcutName": "LeDoK",
      "uninstallDisplayName": "LeDoK",
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "LeDoK-${version}-mac.${ext}",
      "extendInfo": {
        "NSDownloadsFolderUsageDescription": "LeDoK sucht im Download-Ordner nach neuen, signierten Update-Dateien (.ledok-update).",
        "NSDocumentsFolderUsageDescription": "LeDoK legt Sicherungen deiner Daten im Ordner „LeDoK-Sicherungen“ in Dokumente ab.",
        "NSRemovableVolumesUsageDescription": "LeDoK sucht im gewählten Update-Ordner auf einem USB-Stick nach neuen Update-Dateien.",
        "NSNetworkVolumesUsageDescription": "LeDoK sucht im gewählten Update-Ordner auf dem Schulserver nach neuen Update-Dateien."
      }
    },
    "dmg": {
      "title": "LeDoK ${version}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education",
      "artifactName": "LeDoK-${version}.${ext}"
    },
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
